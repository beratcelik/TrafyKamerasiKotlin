<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Pending crash/feedback reports contain log excerpts — keep them
             device-local, never in cloud backups or device transfers. -->
        <exclude domain="file" path="pending_reports" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="pending_reports" />
    </device-transfer>
</data-extraction-rules>